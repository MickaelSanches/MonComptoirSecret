---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsTicker from '../components/NewsTicker.jsx';
import Header from '../components/Header.jsx';
import IPL from '../components/LumierePulsee.jsx';
import FAQ from '../components/FAQIpl.jsx';
import CTAIpl from '../components/CTAIpl.jsx';
import Footer from '../components/Footer.jsx';
---

<BaseLayout>
    <NewsTicker client:load />
    <Header client:load />
    <main class="p-4 text-black">
        <section class="text-center mt-8 space-y-4 cursor-none">
            <a
              href="/epilation-definitive"
              class="inline-block bg-primary text-white border-2 border-primary px-8 py-3 rounded-full font-semibold shadow-md hover:bg-white hover:text-black transition-all duration-300"
            >
              En savoir plus sur l'Épilation Définitive
            </a>
            <a
              href="/photorajeunissement"
              class="inline-block bg-primary text-white border-2 border-primary px-8 py-3 rounded-full font-semibold shadow-md hover:bg-white hover:text-black transition-all duration-300"
            >
              En savoir plus sur le Photorajeunissement
            </a>
          </section>
        <IPL client:load />
    </main>
    <section>
        <FAQ client:load />
        <CTAIpl client:load />
    </section>
    <Footer />
</BaseLayout>
